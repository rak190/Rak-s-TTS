# Virtual Environments
.venv/
.venv-test/
venv/
env/

# Model Weights & Caches
models/
hf_cache/
*.safetensors
*.pth
*.bin

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Application Audio & Temp Storage (preserve folder structure via .gitkeep)
storage/voices/*
!storage/voices/.gitkeep
storage/references/*
!storage/references/.gitkeep
storage/generated/*
!storage/generated/.gitkeep
storage/longform/*
!storage/longform/.gitkeep
storage/mastered/*
!storage/mastered/.gitkeep
storage/temp/*
!storage/temp/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# SQLite Database
*.db
*.db-journal
*.sqlite3
*.zip

# OS Artifacts
Thumbs.db
desktop.ini
.DS_Store
